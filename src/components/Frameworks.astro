---
import { frameworks } from "../config/site";
---

<section class="flex items-center gap-3 flex-wrap pb-12" aria-label="Framework compatibility">
  <span class="font-mono text-[13px] text-faint font-medium">plays nice with</span>
  {
    frameworks.map((fw) => (
      <span class="bg-surface border border-border px-[15px] py-[7px] rounded-full text-sm font-semibold">
        {fw}
      </span>
    ))
  }
</section>
