---
import { checkout } from "../../config/checkout";
import type { BuyPlan } from "../../config/plans";

interface Props { plan: BuyPlan }
const { plan } = Astro.props;
const { href } = checkout.plans[plan.key];
const contact = `mailto:hello@zengrid.dev?subject=${encodeURIComponent(`ZenGrid ${plan.name} license`)}`;
---

<div class="mt-auto">
  {href ? (
    <>
      <a
        href={href}
        rel="noreferrer"
        referrerpolicy="no-referrer"
        aria-label={`Continue to Polar for the ${plan.name} plan`}
        class="flex items-center justify-center rounded-[14px] bg-coral text-white font-semibold text-base px-4 py-[14px] shadow-[0_5px_0_var(--coral-sh)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-coral"
      >
        Continue to Polar →
      </a>
      <p class="text-sm text-muted mt-4 mb-0">You’ll review the total on Polar before paying.</p>
    </>
  ) : (
    <>
      <button
        type="button"
        disabled
        aria-describedby={`${plan.key}-availability`}
        class="w-full rounded-[14px] border border-border bg-surface-2 text-muted font-semibold text-base px-4 py-[14px] cursor-not-allowed"
      >Online checkout unavailable</button>
      <p id={`${plan.key}-availability`} class="text-sm leading-relaxed text-muted mt-4 mb-0">
        <a href={contact} class="underline hover:text-coral-sh focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-coral">Contact us about {plan.name}</a>
        {" "}for availability and license delivery details.
      </p>
    </>
  )}
</div>
