---
import Logo from "./Logo.astro";
import { footer } from "../config/site";

const isExternal = (href: string) => /^https?:\/\//.test(href);
const destination = (href: string) =>
  href.startsWith("#") && Astro.url.pathname !== "/" ? `/${href}` : href;
const linkClass =
  "text-muted hover:text-coral-sh cursor-pointer transition-colors rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-coral";
---

<footer>
  <div class="mx-auto max-w-[1200px] px-5 sm:px-10 py-10 border-t border-border-soft">
  <div class="grid grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1fr] gap-10">
    <div>
      <div class="mb-3.5">
        <Logo size={26} textSize={18} />
      </div>
      <p class="text-sm text-muted max-w-[260px] m-0">{footer.tagline}</p>
    </div>
    {
      footer.columns.map((col) => (
        <nav aria-label={col.title}>
          <div class="font-mono text-[11px] font-bold tracking-[0.08em] uppercase text-faint mb-3.5">
            {col.title}
          </div>
          <div class="flex flex-col gap-2.5 text-sm font-medium">
            {col.links.map((link) => (
              <a
                href={destination(link.href)}
                target={isExternal(link.href) ? "_blank" : undefined}
                rel={isExternal(link.href) ? "noopener noreferrer" : undefined}
                class={linkClass}
              >
                {link.label}
              </a>
            ))}
          </div>
        </nav>
      ))
    }
  </div>

  <div
    class="flex items-center justify-between mt-14 pt-[22px] border-t border-border-soft font-mono text-xs text-faint flex-wrap gap-3"
  >
    <span>{footer.copyright}</span>
    <span class="flex flex-wrap gap-x-5 gap-y-3">
      {
        footer.legal.map((item) => (
          <a
            href={item.href}
            target={isExternal(item.href) ? "_blank" : undefined}
            rel={isExternal(item.href) ? "noopener noreferrer" : undefined}
            class="text-faint hover:text-coral-sh cursor-pointer rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-coral"
          >
            {item.label}
          </a>
        ))
      }
    </span>
  </div>
  </div>
</footer>
