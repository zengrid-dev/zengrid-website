---
interface Props {
  size?: number;
  textSize?: number;
}

const { size = 28, textSize = 20 } = Astro.props;

// Unique per instance so the two logos (nav + footer) don't share a gradient id.
const gradId = "zg-logo-" + Math.random().toString(36).slice(2, 8);
---

<div class="flex items-center gap-[11px]">
  <svg
    width={size}
    height={size}
    viewBox="0 0 64 64"
    fill="none"
    aria-hidden="true"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id={gradId} x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#4ecca3"></stop>
        <stop offset="100%" stop-color="#3db892"></stop>
      </linearGradient>
    </defs>
    <g transform="translate(8, 8)">
      <rect x="0" y="0" width="14" height="14" rx="4" ry="2" fill={`url(#${gradId})`} opacity="0.55"></rect>
      <rect x="17" y="0" width="14" height="14" rx="2" fill={`url(#${gradId})`} opacity="0.7"></rect>
      <rect x="34" y="0" width="14" height="14" rx="2" ry="4" fill={`url(#${gradId})`} opacity="0.55"></rect>
      <rect x="0" y="17" width="14" height="14" rx="2" fill={`url(#${gradId})`} opacity="0.7"></rect>
      <rect x="17" y="17" width="14" height="14" rx="2" fill="#3db892"></rect>
      <rect x="34" y="17" width="14" height="14" rx="2" fill={`url(#${gradId})`} opacity="0.7"></rect>
      <rect x="0" y="34" width="14" height="14" rx="2" ry="4" fill={`url(#${gradId})`} opacity="0.45"></rect>
      <rect x="17" y="34" width="14" height="14" rx="2" fill={`url(#${gradId})`} opacity="0.55"></rect>
      <rect x="34" y="34" width="14" height="14" rx="4" ry="2" fill={`url(#${gradId})`} opacity="0.45"></rect>
    </g>
  </svg>
  <span
    class="font-display font-bold tracking-[-0.02em] text-ink"
    style={`font-size:${textSize}px;`}>ZenGrid</span
  >
</div>
