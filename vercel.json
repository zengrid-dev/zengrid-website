{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "node --version",
  "buildCommand": "npm run deploy:verify",
  "outputDirectory": "dist",
  "bulkRedirectsPath": "vercel-redirects.csv",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "zengrid.dev" }],
      "destination": "https://www.zengrid.dev/:path*",
      "permanent": true
    }
  ]
}
