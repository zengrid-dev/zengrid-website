# Public destinations, read at build time. Do not put API tokens or license
# signing keys in the static host's build environment or PUBLIC_ variables.
POLAR_SOLO_CHECKOUT_URL=https://buy.polar.sh/polar_cl_q5SjcnHkcgYReOxBTDOAU4Qa4E9TONsdZaw4t0ym1Ry
POLAR_TEAM_CHECKOUT_URL=https://buy.polar.sh/polar_cl_N3Zgi1e254i0hMvduXrgYSbSmHIYWoCPfRhMC2RV8lg
POLAR_PORTAL_URL=https://polar.sh/zengrid/portal

# Safe local defaults. Production's public checkout state is committed separately
# in .env.production so a fresh production build reproduces the reviewed site.
ZENGRID_LICENSE_DELIVERY=disabled
POLAR_SOLO_READY=false
POLAR_TEAM_READY=false
# Optional LOCAL administration only; never use a PUBLIC_ prefix or send to a browser.
# POLAR_ACCESS_TOKEN=
# npm run payments:audit checks live pricing and Polar's account capabilities.
