{
  "name": "zengrid-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "rm -rf .astro",
    "dev": "astro dev",
    "prebuild": "rm -rf .astro",
    "build": "astro build",
    "deploy:prepare": "npm run build && npm run test:payments && npm run deploy:verify",
    "deploy:verify": "node scripts/deployment/verify-prebuilt.mjs",
    "test:payments": "node --experimental-strip-types --test tests/payments-*.test.mjs",
    "payments:audit": "node --experimental-strip-types scripts/payments/audit-polar.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.41.7",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/language": "^6.11.3",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@lezer/highlight": "^1.2.1",
    "@noble/curves": "^1.9.7",
    "@tailwindcss/vite": "^4.3.3",
    "@zengrid/core": "1.6.0",
    "astro": "^7.2.0",
    "codemirror": "^6.0.2",
    "motion": "^12.42.2",
    "starlight-versions": "^0.9.1",
    "tailwindcss": "^4.3.3"
  }
}
